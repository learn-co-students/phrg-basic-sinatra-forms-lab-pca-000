<!DOCTYPE html>
<html>
 <head>
  <meta charset="UTF-8">
  <title>Basketball Team Signup</title>
 </head>
 <body>
    <h1>Create a Basketball Team!</h1>
    <form action="/team" method="POST">
      <label for="name">Team Name:</label><br>
      <input type="text" id="name" name="name"><br>

      <label for="coach">Coach:</label><br>
      <input type="text" id="coach" name="coach">

      <label for="pg">Point Guard:</label><br>
      <input type="pg" id="pg" name="pg">

      <label for="sg">Shooting Guard:</label><br>
      <input type="sg" id="sg" name="sg">

      <label for="sf">Small Forward:</label><br>
      <input type="sf" id="sf" name="sf">

      <label for="pf">Power Forward:</label><br>
      <input type="pf" id="pf" name="pf">

      <label for="c">Center:</label><br>
      <input type="c" id="c" name="c">

      <button type="submit" id="submit" value="Submit">Submit</button>
    </form>
 </body>
</html>
